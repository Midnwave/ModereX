# ModereX Gateway Configuration
# Copy this to .env and customize

# Gateway port (default: 3000)
PORT=3000

# Gateway public URL (optional)
# Set this to skip cloudflared tunnel auto-launch
# For local development: http://localhost:3000
# For production tunnel: https://your-domain.trycloudflare.com
GATEWAY_URL=http://localhost:3000

# Admin panel development key (optional)
# Allows bypassing Cloudflare Access authentication for local testing
# IMPORTANT: Remove or keep secret in production!
# ADMIN_DEV_KEY=your-secret-key-here
